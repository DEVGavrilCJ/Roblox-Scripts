local npc = script.Parent
local humanoid = npc:WaitForChild("Humanoid")
local root = npc:WaitForChild("HumanoidRootPart")

local PathfindingService = game:GetService("PathfindingService")
local Players = game:GetService("Players")

-- CONFIG
local DETECTION_RANGE = 60
local LOST_TIME = 3

-- STATES
local STATE_IDLE = "Idle"
local STATE_CHASE = "Chase"
local state = STATE_IDLE

local targetPlayer = nil
local lastSeenTime = 0

------------------------------------------------
-- Utility: get random part in workspace
------------------------------------------------
local function getRandomDestinationPart()
	local parts = workspace:GetChildren()
	local valid = {}

	for _, obj in ipairs(parts) do
		if obj:IsA("BasePart") then
			table.insert(valid, obj)
		end
	end

	if #valid == 0 then return nil end
	return valid[math.random(1, #valid)]
end

------------------------------------------------
-- Path movement
------------------------------------------------
local function moveTo(position)
	local path = PathfindingService:CreatePath({
		AgentRadius = 2,
		AgentHeight = 5,
		AgentCanJump = true,
	})

	path:ComputeAsync(root.Position, position)

	if path.Status == Enum.PathStatus.Success then
		for _, waypoint in ipairs(path:GetWaypoints()) do
			humanoid:MoveTo(waypoint.Position)
			humanoid.MoveToFinished:Wait()
		end
	end
end

------------------------------------------------
-- Find closest valid player
------------------------------------------------
local function getClosestPlayer()
	local closest = nil
	local closestDist = DETECTION_RANGE

	for _, player in ipairs(Players:GetPlayers()) do
		local char = player.Character
		if char and char:FindFirstChild("HumanoidRootPart") then
			local hum = char:FindFirstChild("Humanoid")

			-- IMPORTANT RULE: ignore if sitting
			if hum and not hum.Sit then
				local dist = (char.HumanoidRootPart.Position - root.Position).Magnitude

				if dist < closestDist then
					closestDist = dist
					closest = player
				end
			end
		end
	end

	return closest
end

------------------------------------------------
-- IDLE STATE
------------------------------------------------
local function idleBehavior()
	state = STATE_IDLE

	while state == STATE_IDLE do
		local part = getRandomDestinationPart()

		if part then
			moveTo(part.Position)
		end

		task.wait(1)
	end
end

------------------------------------------------
-- CHASE STATE
------------------------------------------------
local function chaseBehavior()
	state = STATE_CHASE

	while state == STATE_CHASE do
		if not targetPlayer then break end

		local char = targetPlayer.Character
		if not char or not char:FindFirstChild("HumanoidRootPart") then
			targetPlayer = nil
			break
		end

		local hum = char:FindFirstChild("Humanoid")

		-- stop chasing if player is sitting
		if hum and hum.Sit then
			targetPlayer = nil
			break
		end

		local dist = (char.HumanoidRootPart.Position - root.Position).Magnitude

		if dist <= DETECTION_RANGE then
			lastSeenTime = tick()
		end

		-- follow player
		moveTo(char.HumanoidRootPart.Position)

		-- lost check
		if tick() - lastSeenTime > LOST_TIME then
			targetPlayer = nil
			state = STATE_IDLE
			break
		end

		task.wait(0.2)
	end
end

------------------------------------------------
-- MAIN LOOP
------------------------------------------------
task.spawn(function()
	while true do
		if state == STATE_IDLE then
			local player = getClosestPlayer()
			if player then
				targetPlayer = player
				lastSeenTime = tick()
				chaseBehavior()
			else
				idleBehavior()
			end
		end

		task.wait(0.2)
	end
end)
