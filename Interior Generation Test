-- Roblox Lua: Simple branching generator
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local RoomsFolder = ReplicatedStorage:WaitForChild("Rooms")
local MainRoom = Workspace:WaitForChild("MainRoom")

local MAX_ROOMS = 20
local roomCount = 0

-- Track doors that have already spawned something
local usedDoors = {}

-- Get all doors (Models with a Base part) in a room
local function getDoors(roomModel)
	local doors = {}
	for _, obj in pairs(roomModel:GetDescendants()) do
		if obj:IsA("Model") and obj:FindFirstChild("Base") then
			if string.find(obj.Name, "Door") then
				table.insert(doors, obj)
			end
		end
	end
	return doors
end

-- Pick a random room from Rooms folder
local function getRandomRoom()
	local list = RoomsFolder:GetChildren()
	if #list == 0 then return nil end
	return list[math.random(1, #list)]:Clone()
end

-- Find the first door inside a room
local function getRoomDoor(room)
	for _, obj in pairs(room:GetDescendants()) do
		if obj:IsA("Model") and obj:FindFirstChild("Base") then
			if string.find(obj.Name, "Door") then
				return obj
			end
		end
	end
	return nil
end

-- Align room door to mainDoor's Base
local function placeRoom(mainDoor, room)
	local mainBase = mainDoor:FindFirstChild("Base")
	local roomDoor = getRoomDoor(room)
	if not mainBase or not roomDoor then return false end

	local roomBase = roomDoor:FindFirstChild("Base")
	if not roomBase then return false end

	local offset = roomBase.CFrame:Inverse() * room:GetPivot()
	local targetPivot = mainBase.CFrame * offset

	room:PivotTo(targetPivot)
	return true
end

-- Recursive generation function
local function spawnFromDoor(mainDoor)
	if roomCount >= MAX_ROOMS then return end
	if usedDoors[mainDoor] then return end

	local room = getRandomRoom()
	if not room then return end

	room.Parent = Workspace
	local success = placeRoom(mainDoor, room)
	if not success then
		room:Destroy()
		return
	end

	roomCount += 1
	usedDoors[mainDoor] = true

	-- Stop room: do not expand from this room
	if room.Name == "Stop" then
		return
	end

	-- Spawn further from other doors inside this room
	for _, newDoor in ipairs(getDoors(room)) do
		-- skip the door used to connect to parent
		if newDoor ~= getRoomDoor(room) then
			spawnFromDoor(newDoor)
		end
	end
end

-- Start generation from MainRoom doors
for _, door in ipairs(getDoors(MainRoom)) do
	spawnFromDoor(door)
end
