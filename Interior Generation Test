local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local InteriorsFolder = ReplicatedStorage:WaitForChild("Interiors")
local MainRoom = Workspace:WaitForChild("MainRoom")

local MAX_ROOMS = 20  -- Total number of interiors to spawn
local roomCount = 0

local usedDoors = {}

-- Get all door models from a room (MainRoom or Interior)
local function getDoors(roomModel)
	local doors = {}
	for _, obj in pairs(roomModel:GetDescendants()) do
		if obj:IsA("Model") and obj:FindFirstChild("Base") then
			if string.find(obj.Name, "Door") then
				table.insert(doors, obj)
			end
		end
	end
	return doors
end

-- Pick a random interior model
local function getRandomInterior()
	local interiors = InteriorsFolder:GetChildren()
	if #interiors == 0 then return nil end
	return interiors[math.random(1, #interiors)]:Clone()
end

-- Get the first door inside an interior
local function getInteriorDoor(interior)
	for _, obj in pairs(interior:GetDescendants()) do
		if obj:IsA("Model") and obj:FindFirstChild("Base") then
			if string.find(obj.Name, "Door") then
				return obj
			end
		end
	end
	return nil
end

-- Snap interior so its door aligns with mainDoor
local function placeInterior(mainDoor, interior)
	local mainBase = mainDoor:FindFirstChild("Base")
	local interiorDoor = getInteriorDoor(interior)
	if not mainBase or not interiorDoor then return false end

	local interiorBase = interiorDoor:FindFirstChild("Base")
	if not interiorBase then return false end

	local offset = interiorBase.CFrame:Inverse() * interior:GetPivot()
	local targetPivot = mainBase.CFrame * offset

	interior:PivotTo(targetPivot)
	return true
end

-- Main generation function
local function generateInteriors()
	local queue = {}

	-- Start with MainRoom doors
	for _, door in ipairs(getDoors(MainRoom)) do
		table.insert(queue, door)
	end

	while #queue > 0 and roomCount < MAX_ROOMS do
		local mainDoor = table.remove(queue, 1)

		if usedDoors[mainDoor] then
			continue
		end

		local interior = getRandomInterior()
		if not interior then break end

		interior.Parent = Workspace

		local success = placeInterior(mainDoor, interior)

		if success then
			usedDoors[mainDoor] = true
			roomCount += 1

			-- Stop room: end only this branch
			if interior.Name == "Stop" then
				continue
			end

			-- Add new interior doors to queue for expansion
			for _, newDoor in ipairs(getDoors(interior)) do
				-- Skip interior doors already aligned to mainDoor
				if newDoor ~= getInteriorDoor(interior) then
					table.insert(queue, newDoor)
				end
			end
		else
			interior:Destroy()
		end
	end
end

generateInteriors()
