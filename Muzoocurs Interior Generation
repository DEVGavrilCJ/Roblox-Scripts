local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Interiors = ReplicatedStorage:WaitForChild("Interiors")
local Items = ReplicatedStorage:WaitForChild("Items")
local GoalItem = ReplicatedStorage:WaitForChild("GoalItem")
local StopRoom = ReplicatedStorage:WaitForChild("Stop")

local Generated = workspace:WaitForChild("Generated")
local MainRoom = workspace:WaitForChild("MainRoom")

local Prompt = workspace.Lobby.Bell.ProximityPrompt

local Generating = false

------------------------------------------------
-- CONFIG
------------------------------------------------

local MAX_ROOMS = math.random(30, 200)

------------------------------------------------
-- STATE
------------------------------------------------

local RoomsPlaced = 0
local GoalPlaced = false

local OpenEnds = {}
local ItemSpawns = {}

------------------------------------------------
-- UTIL
------------------------------------------------

local function GetRandomInterior()
	local list = Interiors:GetChildren()
	return list[math.random(#list)]:Clone()
end

local function SpawnRandomItem(itemPart)
	local pool = Items:GetChildren()
	if #pool == 0 then return end

	-- item chance
	if math.random(1, 4) ~= 1 then return end

	local item = pool[math.random(#pool)]:Clone()
	item:PivotTo(itemPart.CFrame)
	item.Parent = Generated
end

------------------------------------------------
-- EXIT REGISTRATION (end + multi branching)
------------------------------------------------

local function RegisterExits(room)

	-- normal exit
	local endPart = room:FindFirstChild("end")
	if endPart then
		table.insert(OpenEnds, endPart)
	end

	-- branching exit
	local multiPart = room:FindFirstChild("multi")

	if multiPart then
		-- always usable as an exit
		table.insert(OpenEnds, multiPart)

		-- sometimes duplicate to create branching pressure
		if math.random(1, 100) <= 40 then
			table.insert(OpenEnds, multiPart)
		end
	end
end

------------------------------------------------
-- GENERATION
------------------------------------------------

local function GenerateDungeon()

	table.clear(OpenEnds)
	table.clear(ItemSpawns)

	RoomsPlaced = 0
	GoalPlaced = false

	-- starting exits
	table.insert(OpenEnds, MainRoom.Interior1)
	table.insert(OpenEnds, MainRoom.Interior2)

	while RoomsPlaced < MAX_ROOMS and #OpenEnds > 0 do

		local index = math.random(#OpenEnds)
		local target = table.remove(OpenEnds, index)

		local room = GetRandomInterior()

		-- ensure primary part
		if not room.PrimaryPart then
			room.PrimaryPart = room:FindFirstChild("begin")
		end

		room:PivotTo(target.CFrame)
		room.Parent = Generated

		------------------------------------------------
		-- register new exits
		------------------------------------------------
		RegisterExits(room)

		------------------------------------------------
		-- item spawn points
		------------------------------------------------
		local itemPart = room:FindFirstChild("item")
		if itemPart then
			table.insert(ItemSpawns, itemPart)
			SpawnRandomItem(itemPart)
		end

		------------------------------------------------
		Rooms counter
		------------------------------------------------
		RoomsPlaced += 1
	end

	------------------------------------------------
	-- STOP ROOMS (cap all branches)
	------------------------------------------------

	for _, openEnd in ipairs(OpenEnds) do

		local stop = StopRoom:Clone()

		if not stop.PrimaryPart then
			stop.PrimaryPart = stop:FindFirstChild("begin")
		end

		stop:PivotTo(openEnd.CFrame)
		stop.Parent = Generated
	end

	------------------------------------------------
	-- GUARANTEE GOAL ITEM (Diamond)
	------------------------------------------------

	if not GoalPlaced and #ItemSpawns > 0 then

		local spawn = ItemSpawns[math.random(#ItemSpawns)]

		local diamond = GoalItem:Clone()
		diamond.CFrame = spawn.CFrame
		diamond.Parent = Generated

		GoalPlaced = true
	end
end

------------------------------------------------
-- START GENERATION
------------------------------------------------

Prompt.Triggered:Connect(function()

	if Generating then return end
	Generating = true

	Generated:ClearAllChildren()

	task.wait(0.1)

	GenerateDungeon()

	Generating = false
end)
