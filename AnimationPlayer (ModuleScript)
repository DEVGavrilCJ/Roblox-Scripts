local RunService = game:GetService("RunService")

local AnimationPlayer = {}
local States = {}

local function getState(character)
	if not States[character] then
		States[character] = {
			token = 0,
			baseC0 = {}
		}

		-- store original joint offsets ONCE
		for _, obj in ipairs(character:GetDescendants()) do
			if obj:IsA("Motor6D") then
				States[character].baseC0[obj.Name] = obj.C0
			end
		end
	end
	return States[character]
end

local function tweenPose(character, frame, duration, speed, state, tokenRef)
	local joints = {}

	for jointName, info in pairs(frame) do
		local joint = character:FindFirstChild(jointName, true)

		if joint and joint:IsA("Motor6D") then
			local base = state.baseC0[jointName]
			if base then
				table.insert(joints, {
					joint = joint,
					start = joint.C0,
					target = base * info.CFrame -- 🔥 IMPORTANT FIX
				})
			end
		end
	end

	local t = 0
	duration = (duration or 0) / (speed or 1)

	while t < duration do
		if tokenRef.stop then return end

		local dt = RunService.RenderStepped:Wait()
		t += dt

		local alpha = math.clamp(t / duration, 0, 1)

		for _, j in ipairs(joints) do
			j.joint.C0 = j.start:Lerp(j.target, alpha)
		end
	end

	for _, j in ipairs(joints) do
		j.joint.C0 = j.target
	end
end

function AnimationPlayer.Play(character, animTable, looped, speed)
	if not character or not animTable then return end

	local state = getState(character)
	state.token += 1

	local tokenRef = { id = state.token, stop = false }

	task.spawn(function()
		repeat
			for i = 1, #animTable do
				if state.token ~= tokenRef.id then
					tokenRef.stop = true
					return
				end

				local frame = animTable[i]

				local duration = 0
				for _, info in pairs(frame) do
					duration = info.TimeLength or 0
					break
				end

				tweenPose(character, frame, duration, speed, state, tokenRef)
			end
		until not looped
	end)
end

function AnimationPlayer.Stop(character)
	if States[character] then
		States[character].token += 1
	end
end

return AnimationPlayer
